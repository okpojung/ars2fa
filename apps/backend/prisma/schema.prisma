generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum AdminRole {
  SUPER_ADMIN
  REVIEWER
  OPERATOR
  KEY_MANAGER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
}

enum AppPlatform {
  ANDROID
  IOS
}

enum AppStatus {
  PENDING
  APPROVED
  DISABLED
}

enum ApiKeyEnvironment {
  TEST
  LIVE
}

enum ApiKeyStatus {
  ACTIVE
  SUSPENDED
  ROTATED
  REVOKED
  EXPIRED
}

enum AuthRequestStatus {
  INSTALL_REQUESTED
  INSTALL_SUCCEEDED
  INSTALL_FAILED
  CONFIRM_REQUESTED
  AUTH_SUCCEEDED
  MANUAL_REQUIRED
  RETRY_REQUIRED
  AUTH_FAILED
  MANUAL_SUCCEEDED
  MANUAL_FAILED
}

enum AuthEventType {
  INSTALL
  CONFIRM
  RECHECK
  STATUS_QUERY
  ERROR
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  companyName     String
  businessNumber  String?
  contactName     String
  contactPhone    String
  status          UserStatus       @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    ApiApplication[]
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         AdminRole       @default(REVIEWER)
  status       UserStatus      @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  reviews      ReviewHistory[]
}

model ApiApplication {
  id                      String             @id @default(cuid())
  userId                  String
  serviceName             String
  usagePurpose            String
  expectedMonthlyRequests Int
  allowedIps              String?
  callbackUrl             String?
  status                  ApplicationStatus  @default(DRAFT)
  adminComment            String?
  submittedAt             DateTime?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  user                    User               @relation(fields: [userId], references: [id])
  apps                    ApplicationApp[]
  apiKeys                 ApiKey[]
  reviewHistories         ReviewHistory[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model ApplicationApp {
  id             String          @id @default(cuid())
  applicationId  String
  mobileAppName  String
  platform       AppPlatform
  packageName    String?
  bundleId       String?
  storeUrl       String?
  status         AppStatus       @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  application    ApiApplication  @relation(fields: [applicationId], references: [id])
  authRequests   AuthRequest[]

  @@unique([applicationId, mobileAppName, platform])
  @@index([mobileAppName, platform])
}

model ApiKey {
  id                 String            @id @default(cuid())
  applicationId      String
  keyPrefix          String
  keyHash            String            @unique
  environment        ApiKeyEnvironment @default(TEST)
  status             ApiKeyStatus      @default(ACTIVE)
  monthlyLimit       Int               @default(10000)
  rateLimitPerMinute Int?
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  application        ApiApplication    @relation(fields: [applicationId], references: [id])
  authRequests       AuthRequest[]

  @@index([applicationId])
  @@index([status])
}

model AuthRequest {
  id                 String            @id @default(cuid())
  requestId          String            @unique
  apiKeyId           String
  applicationAppId   String?
  mobileAppName      String
  clientPlatform     AppPlatform
  packageName        String?
  bundleId           String?
  appsid             String
  appuuid            String?
  appip              String?
  status             AuthRequestStatus
  callCount          Int?
  phoneHash          String?
  phoneMasked        String?
  providerMessage    String?
  requestedAt        DateTime          @default(now())
  confirmedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  apiKey             ApiKey            @relation(fields: [apiKeyId], references: [id])
  applicationApp     ApplicationApp?   @relation(fields: [applicationAppId], references: [id])
  events             AuthEvent[]

  @@index([apiKeyId, requestedAt])
  @@index([status])
  @@index([appsid])
  @@index([appuuid])
  @@index([phoneHash])
}

model AuthEvent {
  id                    String        @id @default(cuid())
  authRequestId          String?
  apiKeyId               String?
  eventType              AuthEventType
  endpoint               String
  httpStatus             Int?
  errorCode              String?
  message                String?
  requestPayloadMasked   Json?
  responsePayloadMasked  Json?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime      @default(now())
  authRequest            AuthRequest?  @relation(fields: [authRequestId], references: [id])

  @@index([authRequestId])
  @@index([createdAt])
  @@index([errorCode])
}

model ReviewHistory {
  id             String             @id @default(cuid())
  applicationId  String
  adminUserId    String
  fromStatus     ApplicationStatus?
  toStatus       ApplicationStatus
  comment        String?
  createdAt      DateTime           @default(now())
  application    ApiApplication     @relation(fields: [applicationId], references: [id])
  adminUser      AdminUser          @relation(fields: [adminUserId], references: [id])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorType   ActorType
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
